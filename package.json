{
  "name": "ai-playwright-course",
  "private": true,
  "scripts": {
    "app": "node demo-app/server.js",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:fail-demo": "playwright test --config=playwright.fail-demo.config.ts",
    "gen:users": "tsx scripts/gen-users.ts",
    "gen:edge": "tsx scripts/gen-edge-cases.ts",
    "gen:products": "tsx scripts/gen-products.ts",
    "db:up": "docker compose up -d",
    "heal:apply": "tsx scripts/apply-heals.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "gherkin": "tsx scripts/req-to-gherkin.ts",
    "summary": "tsx scripts/summarise-run.ts",
    "demo:all": "tsx scripts/demo-all.ts",
    "module3": "tsx scripts/module3.ts",
    "test:bdd": "npx bddgen && npx playwright test",
    "allure:clean": "npx tsx -e \"import fs from 'fs'; fs.rmSync('allure-results', {recursive:true, force:true});\"",
    "allure:history": "tsx scripts/preserve-allure-history.ts",
    "allure:generate": "npm run allure:history && npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "allure:serve": "npm run allure:history && npx allure serve allure-results"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^13.3.0",
    "@cucumber/messages": "^34.2.1",
    "@playwright/test": "^1.56.0",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "allure-commandline": "^2.46.1",
    "allure-cucumberjs": "^3.13.0",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "playwright-bdd": "^9.2.1",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "openai": "^5.0.0",
    "pg": "^8.12.0",
    "zod": "^3.23.8"
  }
}
